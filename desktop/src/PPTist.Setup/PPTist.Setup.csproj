<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PPTist-Setup</AssemblyName>
  </PropertyGroup>
  <ItemGroup Condition="'$(PPTistPayloadDir)' != ''">
    <EmbeddedResource Include="$(PPTistPayloadDir)\runtime\**\*">
      <LogicalName>payload/runtime/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PPTistPayloadDir)\office-addin\**\*">
      <LogicalName>payload/office-addin/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PPTistPayloadDir)\powerpoint-addin\**\*">
      <LogicalName>payload/powerpoint-addin/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
