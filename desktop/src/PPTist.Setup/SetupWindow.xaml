<Window x:Class="PPTist.Setup.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PPTist 动效插件安装程序" Width="510" Height="250" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <Grid Margin="34">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="正在安装 PPTist Office / WPS 动效插件" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="安装一次后，可在任意 PowerPoint 或 WPS 演示文件中使用 HTML 动效。" Foreground="#666" TextWrapping="Wrap" />
    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,24,0,0" Text="正在准备…" TextWrapping="Wrap" />
    <ProgressBar x:Name="Progress" Grid.Row="3" Height="7" Minimum="0" Maximum="100" IsIndeterminate="True" />
  </Grid>
</Window>
