<Window x:Class="PPTist.Setup.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PPTist PowerPoint 加载项安装程序" Width="560" Height="280" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <Grid Margin="34">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="正在安装 PPTist PowerPoint 动效" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="安装后可在 Microsoft PowerPoint 的加载项中启用 HTML/CSS/JavaScript 动效。" Foreground="#666" TextWrapping="Wrap" />
    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,24,0,0" Text="正在准备…" TextWrapping="Wrap" />
    <ProgressBar x:Name="Progress" Grid.Row="3" Height="7" Minimum="0" Maximum="100" IsIndeterminate="True" />
  </Grid>
</Window>
