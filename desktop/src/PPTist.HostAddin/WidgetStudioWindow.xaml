<Window x:Class="PPTist.HostAddin.WidgetStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PPTist HTML 动效" Width="900" Height="690" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="DocumentInfo" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,12" />
      <ComboBox x:Name="TemplateBox" Grid.Row="1" SelectionChanged="OnTemplateChanged" Margin="0,0,0,12">
        <ComboBoxItem Content="自定义 HTML" IsSelected="True" />
        <ComboBoxItem Content="幸运转盘" />
        <ComboBoxItem Content="雨滴" />
        <ComboBoxItem Content="萤火虫" />
      </ComboBox>
      <ListBox x:Name="WidgetList" Grid.Row="2" DisplayMemberPath="Id" SelectionChanged="OnWidgetSelected" />
      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="新建" Click="OnNew" Padding="16,5" />
        <Button Content="删除" Click="OnDelete" Padding="16,5" Margin="8,0,0,0" />
      </StackPanel>
    </Grid>
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
        <TextBox x:Name="NameBox" Margin="0,0,8,0" ToolTip="组件名称" />
        <TextBox x:Name="LeftBox" Grid.Column="1" Text="340" ToolTip="左边距" Margin="0,0,6,0" />
        <TextBox x:Name="TopBox" Grid.Column="2" Text="170" ToolTip="上边距" Margin="0,0,6,0" />
        <TextBox x:Name="WidthBox" Grid.Column="3" Text="320" ToolTip="宽度" Margin="0,0,6,0" />
        <TextBox x:Name="HeightBox" Grid.Column="4" Text="220" ToolTip="高度" />
      </Grid>
      <GroupBox Header="HTML" Grid.Row="1" Margin="0,0,0,8"><TextBox x:Name="HtmlBox" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></GroupBox>
      <GroupBox Header="CSS" Grid.Row="2" Margin="0,0,0,8"><TextBox x:Name="CssBox" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></GroupBox>
      <GroupBox Header="JavaScript" Grid.Row="3" Margin="0,0,0,8"><TextBox x:Name="JavaScriptBox" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></GroupBox>
      <DockPanel Grid.Row="4"><TextBlock Text="坐标基于 1000 × 562.5 画布；保存后按当前页在原生放映时叠加。" Foreground="#777" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="保存到当前页" Click="OnSave" Padding="20,6" /></DockPanel>
    </Grid>
  </Grid>
</Window>
